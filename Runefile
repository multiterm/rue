build: pnpm -r exec rune build
test: pnpm -r exec rune test
test-e2e: pnpm --workspace-concurrency=1 --filter './packages/apps/**' -r exec rune test-e2e
playwright-install: playwright install chromium
playwright-install-ci: playwright install --with-deps chromium
typecheck: pnpm -r exec rune typecheck
lint: pnpm -r exec rune lint
format: prettier --write . --ignore-unknown
format-check: git diff --check
quality-unit: vitest run --config quality/vitest.config.ts
quality-crap: node quality/check-crap.mjs
quality-audit: node quality/check-audit.mjs
quality-fast: rune quality-unit && rune quality-crap
quality-static: rune format-check && rune typecheck && rune test && rune build && rune quality-fast && rune quality-audit
quality-playwright: playwright test --config quality/playwright.config.ts
quality-deployed: rune quality-playwright
quality: rune quality-static && rune test-e2e
clean: pnpm -r exec rm -rf dist node_modules && rm -rf node_modules

release: pnpm exec m-release --yes
release-dry: pnpm exec m-release --dry-run
hooks-install: pnpm exec m-release hook install .
hooks-status: pnpm exec m-release hook status .

sandblocks-validate: pnpm exec sandblocks validate .
sandblocks-doctor: pnpm exec sandblocks doctor .
sandblocks-register: pnpm exec sandblocks register .
sandblocks-hooks-install: chmod 755 .hooks/post-commit .hooks/pre-commit .hooks/pre-push scripts/deployment/sandblocks-post-commit.mjs scripts/deployment/runway-post-commit.mjs packages/apps/mobile/scripts/runway-publish.mjs && git config core.hooksPath .hooks
sandblocks-hooks-status: test "$(git config --get core.hooksPath)" = ".hooks" && echo "Rue hooks installed: Sandblocks + Runway (develop/development, pre/preview, prod/production); local quality gates enabled"
deploy: pnpm exec sandblocks sandbox up .
redeploy: pnpm exec sandblocks sandbox redeploy .
status: pnpm exec sandblocks sandbox status .
destroy: pnpm exec sandblocks sandbox down .

runway-push: pnpm --filter @multiterm/rue-mobile exec rune runway-dev-build-and-push-apk
runway-push-preview: pnpm --filter @multiterm/rue-mobile exec rune runway-preview-build-and-push-apk
runway-push-production: pnpm --filter @multiterm/rue-mobile exec rune runway-production-build-and-push-apk
runway-dry-run: pnpm --filter @multiterm/rue-mobile exec rune runway-dry-run
runway-post-commit-dry-run: RUNWAY_POST_COMMIT_DRY_RUN=1 RUNWAY_POST_COMMIT_FOREGROUND=1 RUNWAY_POST_COMMIT_ALLOW_DIRTY=1 RUNWAY_FORCE_POST_COMMIT=1 node scripts/deployment/runway-post-commit.mjs
