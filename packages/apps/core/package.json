{
  "name": "@multiterm/rue-core",
  "version": "0.0.0",
  "description": "Rue core — HTTP server, agentic engine, tools, providers, persistence. CLI entry for `rue serve`, `rue run`, `rue tui`, etc.",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "bin": {
    "rue": "src/bin.ts"
  },
  "exports": {
    ".": "./src/index.ts",
    "./server": "./src/server/index.ts",
    "./storage": "./src/storage/index.ts",
    "./config": "./src/config/index.ts",
    "./bus": "./src/bus/index.ts",
    "./global": "./src/global/index.ts",
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@hono/node-server": "^1.14.0",
    "@hono/zod-openapi": "^1.4.0",
    "@multiterm/rue-db": "workspace:*",
    "@multiterm/rue-trpc": "workspace:*",
    "@trpc/server": "catalog:",
    "better-sqlite3": "^11.10.0",
    "hono": "^4.11.0",
    "keytar": "^7.9.0",
    "tsx": "catalog:",
    "xdg-basedir": "^5.1.0",
    "yargs": "^17.7.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@playwright/test": "catalog:",
    "@types/better-sqlite3": "^7.6.0",
    "@types/node": "catalog:",
    "@types/yargs": "^17.0.0",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
