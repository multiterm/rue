{
  "name": "@multiterm/rue-worker",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "Rue managed-host supervisor: fenced Pi lifecycle, private workspaces and host diagnostics.",
  "bin": { "rue-worker": "dist/cli.js" },
  "files": ["dist", "README.md"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:binary": "bun build src/cli.ts --compile --outfile dist/rue-worker",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": { "ws": "8.21.3", "zod": "4.4.3" },
  "devDependencies": {
    "@multiterm/rue-sdk": "workspace:*",
    "@types/node": "catalog:",
    "@types/ws": "^8.18.1",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "engines": { "node": ">=22" }
}
