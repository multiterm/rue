start: APP_VARIANT=development expo start -c
android: APP_VARIANT=development expo run:android
dev-web: CI=1 APP_VARIANT=development EXPO_PUBLIC_KEYNAME_CLIENT_ID=knc_playwright expo start --web --port 5180 --clear
build: tsc --noEmit
typecheck: tsc --noEmit
test: vitest run --passWithNoTests --exclude "tests/e2e/**"
test-e2e: playwright test
lint: tsc --noEmit
runway-assert-remote: node scripts/assert-runway-remote.cjs
runway-dev-push-apk: node scripts/runway-publish.mjs --build-type=development --no-assemble
runway-dev-build-and-push-apk: node scripts/runway-publish.mjs --build-type=development
runway-preview-build-and-push-apk: node scripts/runway-publish.mjs --build-type=preview
runway-production-build-and-push-apk: node scripts/runway-publish.mjs --build-type=production
runway-dry-run: node scripts/runway-publish.mjs --build-type=development --dry-run
