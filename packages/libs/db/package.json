{
  "name": "@multiterm/rue-db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Drizzle schema and database adapter for Rue.",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "development": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./postgres": {
      "types": "./src/postgres/index.ts",
      "development": "./src/postgres/index.ts",
      "default": "./dist/postgres/index.js"
    },
    "./session-repository": {
      "types": "./src/session-repository.ts",
      "development": "./src/session-repository.ts",
      "default": "./dist/session-repository.js"
    },
    "./schema": {
      "types": "./src/schema.ts",
      "development": "./src/schema.ts",
      "default": "./dist/schema.js"
    }
  },
  "scripts": {
    "db:generate": "drizzle-kit generate",
    "test:postgres": "node --import tsx --test tests/postgres.node.ts"
  },
  "dependencies": {
    "better-sqlite3": "^11.10.0",
    "drizzle-orm": "^0.45.2",
    "postgres": "3.4.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.0",
    "drizzle-kit": "0.31.9",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
