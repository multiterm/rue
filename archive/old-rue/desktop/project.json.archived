{
  "$schema": "../../../../node_modules/nx/schemas/project-schema.json",
  "name": "@multiterm/rue-desktop",
  "projectType": "application",
  "sourceRoot": "packages/apps/rue/desktop/src",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": { "command": "pnpm --filter @multiterm/rue-desktop run build" },
      "outputs": ["{projectRoot}/dist"]
    },
    "build:win": {
      "executor": "nx:run-commands",
      "options": { "command": "pnpm --filter @multiterm/rue-desktop run build:win" },
      "outputs": ["{projectRoot}/release"]
    },
    "dev": {
      "executor": "nx:run-commands",
      "options": { "command": "pnpm --filter @multiterm/rue-desktop run dev" }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": { "command": "pnpm --filter @multiterm/rue-desktop run typecheck" }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": { "command": "pnpm --filter @multiterm/rue-desktop run lint" }
    }
  }
}
