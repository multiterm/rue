{
  "name": "@rue-archived/desktop",
  "version": "0.0.0",
  "description": "Rue — a desktop AI assistant; chat with context from screenshots, highlighted text, and web pages",
  "private": true,
  "type": "module",
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "build:win": "pnpm run build && electron-builder --win --publish never",
    "build:mac": "pnpm run build && electron-builder --mac --publish never",
    "build:linux": "pnpm run build && electron-builder --linux --publish never",
    "docker:build": "./scripts/docker-build.sh",
    "build:linux:docker": "./scripts/docker-build.sh linux",
    "build:win:docker": "./scripts/docker-build.sh win",
    "build:all:docker": "pnpm run build:mac && pnpm run build:linux:docker && pnpm run build:win:docker",
    "preview": "electron-vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:e2e": "pnpm run build && playwright test",
    "test:e2e:install": "playwright install --with-deps chromium",
    "test:e2e:ui": "pnpm run build && playwright test --ui"
  },
  "keywords": [
    "rue",
    "ai",
    "assistant",
    "electron",
    "react",
    "openrouter"
  ],
  "author": "Super Repo",
  "repository": {
    "type": "git",
    "url": "https://github.com/super-repo/super-repo.git",
    "directory": "packages/apps/rue/desktop"
  },
  "license": "MIT",
  "dependencies": {
    "@huggingface/transformers": "^3.0.0",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "better-sqlite3": "^11.10.0",
    "electron-store": "^10.0.0",
    "katex": "^0.16.11",
    "pdfjs-dist": "^4.7.76",
    "qrcode": "^1.5.4",
    "tesseract.js": "^5.1.1",
    "zod": "^3.25.0",
    "zod-to-json-schema": "^3.24.5"
  },
  "devDependencies": {
    "@fontsource/nunito": "^5.1.0",
    "@playwright/test": "^1.49.0",
    "@super-repo/interport-client": "workspace:*",
    "@super-repo/ui": "workspace:*",
    "framer-motion": "^11.18.0",
    "@tailwindcss/vite": "^4.1.0",
    "@types/better-sqlite3": "^7.6.0",
    "@types/node": "catalog:",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron": "^34.0.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^4.0.0",
    "lucide-react": "^0.479.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^9.0.1",
    "rehype-highlight": "^7.0.0",
    "rehype-katex": "^7.0.0",
    "remark-gfm": "^4.0.0",
    "remark-math": "^6.0.0",
    "tailwind-merge": "^3.3.0",
    "tailwindcss": "^4.1.0",
    "typescript": "catalog:",
    "vite": "^7.0.0",
    "vitest": "catalog:",
    "@vitest/coverage-v8": "^4.1.6"
  }
}
