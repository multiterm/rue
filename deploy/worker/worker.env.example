# Non-secret configuration. Copy to .env; put the secret in a separate root-only file.
RUE_WORKER_API_URL=https://your-rue-api.example.com
RUE_WORKER_ID=00000000-0000-0000-0000-000000000000
RUE_WORKER_SECRET_PATH=/etc/rue-worker/credential.secret
RUE_WORKER_DOCKER_SOCKET=/var/run/docker.sock
RUE_WORKER_IMAGE=rue-worker:local
